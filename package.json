{
  "name": "diario-de-emociones",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma db push --skip-generate && next dev",
    "build": "prisma generate && next build",
    "build:check": "node scripts/build-check.mjs",
    "start": "next start",
    "db:push": "prisma db push",
    "users:sync": "node scripts/sync-users.mjs",
    "user:create": "node scripts/create-user.mjs",
    "user:list": "node scripts/list-users.mjs",
    "user:delete": "node scripts/delete-user.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "prisma": "^6.16.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
