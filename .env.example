# --- Base de datos -----------------------------------------------------------
# En local:  file:./dev.db     (relativo a la carpeta prisma/)
# En Docker: file:/data/diario.db  (volumen persistente)
DATABASE_URL="file:./dev.db"

# --- Sesión ------------------------------------------------------------------
# Clave para firmar la cookie de sesión. GENERA UNA PROPIA:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# Días que dura la sesión antes de pedir login otra vez
SESSION_DAYS="30"

# --- Despliegue --------------------------------------------------------------
# Dominio público desde el que se sirve el diario (sin protocolo).
# Necesario para que las server actions de Next acepten el origen: Cloudflare
# reescribe la cabecera Host y, sin declararlo aquí, el login no responde.
ALLOWED_ORIGINS="diario.tudominio.com"

# Puerto en el que escucha el contenedor. En local, `npm run dev` usa el 3000
# de Next; esto solo afecta al contenedor.
PORT="1312"

# El túnel de Cloudflare NO lo levanta este compose: el contenedor se engancha
# a la red externa `cloudflare`, donde ya corre cloudflared en el servidor.
