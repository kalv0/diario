# --- Base de datos -----------------------------------------------------------
# En local:  file:./dev.db     (relativo a la carpeta prisma/)
# En Docker: file:/data/diario.db  (volumen persistente)
DATABASE_URL="file:./dev.db"

# --- Sesión ------------------------------------------------------------------
# Clave para firmar la cookie de sesión. GENERA UNA PROPIA:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria-de-al-menos-32-caracteres"

# Días que dura la sesión antes de pedir login otra vez
SESSION_DAYS="30"

# --- Despliegue --------------------------------------------------------------
# Dominio público que sirve el túnel de Cloudflare (sin protocolo).
# Necesario para que las server actions de Next acepten el origen.
ALLOWED_ORIGINS="diario.tudominio.com"

# Token del túnel de Cloudflare (Zero Trust > Networks > Tunnels > tu túnel)
TUNNEL_TOKEN=""

# Puerto interno de la app
PORT="3000"
